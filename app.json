{
  "expo": {
    "name": "Makuta",
    "slug": "makuta",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/ios/AppIcon.appiconset/ItunesArtwork@2x.png",
    "scheme": "makuta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zychan.makuta",
      "icon": "./assets/ios/AppIcon.appiconset/ItunesArtwork@2x.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Aplikasi ini memerlukan akses lokasi Anda untuk fitur absensi dan kunjungan",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Aplikasi ini memerlukan akses lokasi Anda untuk fitur absensi dan kunjungan",
        "NSCameraUsageDescription": "Aplikasi ini memerlukan akses kamera Anda untuk fitur absensi dan kunjungan sebagai bukti telah melakukan absensi atau kunjungan"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.zychan.makuta",
      "icon": "./assets/android/mipmap-xxxhdpi/ic_launcher.png",
      "googleServicesFile": "./google-services.json",
      "permissions": ["CAMERA"],
      "intentFilters": [
        {
          "autoVerify": true
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2F80ED"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "androidGradlePluginVersion": "8.3.2",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "27.1.12297006",
            "packagingOptions": {
              "jniLibs": {
                "useLegacyPackaging": false
              }
            }
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ce6f28a5-b3ab-4ebb-9504-e2d385c2434a"
      }
    }
  }
}
